<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- налаштування SpaProxy для з'єднання з React/Vite.
    SpaProxy - це пакет, забезпечує безшовну інтеграцію між бекендом (ASP.NET Core)
    та фронтендом (Dev Server) під час локальної розробки. -->
    <SpaRoot>..\film.client\</SpaRoot>
    <SpaProxyServerUrl>https://localhost:3001</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Film.Application\Film.Application.csproj" />
    <ProjectReference Include="..\Film.Infrastructure\Film.Infrastructure.csproj" />
    <ProjectReference Include="..\Film.Common\Film.Common.csproj" />
  </ItemGroup>

</Project>
