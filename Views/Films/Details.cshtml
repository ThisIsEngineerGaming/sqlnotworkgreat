@model mvc.Film

@{
    ViewData["Title"] = "Details";
}

<style>
    .details-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        width: 100%;
    }
    .details-content {
        text-align: center;
        max-width: 600px;
        width: 100%;
    }
    .details-content dl {
        text-align: center;
    }
    .details-content dt, .details-content dd {
        text-align: center;
        padding: 10px 0;
    }
    .details-content dt {
        font-weight: bold;
        margin-top: 15px;
    }
    .details-content img {
        margin: 20px auto;
        display: block;
    }
    .details-actions {
        margin-top: 30px;
    }
    .details-actions a {
        margin: 0 10px;
        text-decoration: none;
        color: #0066cc;
    }
    .details-actions a:hover {
        text-decoration: underline;
    }
</style>

<div class="details-container">
    <div class="details-content">
        <h4>Film</h4>
        <hr />
        
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Title)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Title)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Director)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Director)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.ReleaseYear)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.ReleaseYear)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Genre)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Genre)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Rating)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Rating)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.PhotoUrl)
            </dt>
            <dd class="col-sm-10">
                @if (!string.IsNullOrEmpty(Model?.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="@Model.Title" style="max-width:300px; height:auto;" />
                }
            </dd>
        </dl>

        <div class="details-actions">
            <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
</div>
