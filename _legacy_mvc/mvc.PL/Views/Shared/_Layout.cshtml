            <p>&copy; by Sunmeat. All rights and lefts reserved. @DateTime.Now - ASP.NET Core MVC is mogmaxxing while others copeskipping</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
