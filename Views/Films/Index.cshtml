<h1>Index</h1>

@model IEnumerable<mvc.Film>

@{
    ViewData["Title"] = "Index";
}

<style>
    .table {
        text-align: center;
    }
    .table td, .table th {
        vertical-align: middle;
        padding: 12px !important;
    }
    .table tbody tr {
        cursor: pointer;
    }
    .table tbody tr:hover {
        background-color: #f5f5f5;
    }
    .film-title {
        color: #0066cc;
        text-decoration: none;
    }
    .film-title:hover {
        text-decoration: underline;
    }
</style>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Director)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhotoUrl)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr onclick="window.location='@Url.Action("Details", "Films", new { id = item.Id })';" style="cursor: pointer;">
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="film-title" onclick="event.stopPropagation();">
                    @Html.DisplayFor(model => item.Title)
                </a>
            </td>
            <td>
                @Html.DisplayFor(model => item.Director)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseYear)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.PhotoUrl))
                {
                    <img src="@item.PhotoUrl" alt="@item.Title" style="width:80px; height:auto; object-fit:cover;" onclick="event.stopPropagation();" />
                }
            </td>
            <td onclick="event.stopPropagation();">
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
